// ============================================================================
// Panduan Membuat Job Pipeline di Jenkins untuk Moodify Backend:
// 1. Buka dashboard Jenkins -> klik "New Item".
// 2. Masukkan nama item (misal: "moodify-backend-ci"), pilih "Pipeline", klik OK.
// 3. Pada bagian "Pipeline":
//    - Pilih Definition: "Pipeline script from SCM"
//    - Pilih SCM: "Git"
//    - Masukkan Repository URL proyek Anda dan branch (misal: */main)
//    - Set "Script Path" ke: backend/Jenkinsfile
// 4. Pastikan NodeJS sudah tersedia di mesin agent Jenkins, atau instal plugin
//    "NodeJS Plugin" lalu daftarkan instalasi NodeJS 18+ di:
//    Manage Jenkins -> Tools -> NodeJS installations (beri nama "nodejs").
//    Jika menggunakan NodeJS Plugin, hapus komentar pada blok `tools { nodejs 'nodejs' }`.
// 5. Klik "Save", lalu klik "Build Now" untuk menjalankan pipeline.
// ============================================================================

pipeline {
    agent any

    // Jika menggunakan Jenkins NodeJS Plugin, aktifkan baris di bawah ini:
    // tools {
    //     nodejs 'nodejs'
    // }

    environment {
        NODE_ENV = 'test'
        JWT_SECRET = 'jenkins-ci-test-secret-key-2026'
        DB_PATH = ':memory:'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'node -v && npm -v'
                            sh 'npm ci'
                        } else {
                            bat 'node -v && npm -v'
                            bat 'npm ci'
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'npm test'
                        } else {
                            bat 'npm test'
                        }
                    }
                    // Arsipkan laporan coverage hasil pengujian Jest
                    archiveArtifacts artifacts: 'coverage/**/*', allowEmptyArchive: true
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir('backend') {
                    archiveArtifacts artifacts: 'src/**/*, package.json, package-lock.json, .env.example, README.md', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline Moodify Backend selesai dijalankan.'
        }
        success {
            echo 'Seluruh tahapan CI dan pengujian otomatis berhasil!'
        }
        failure {
            echo 'Terdapat kegagalan pada pipeline. Periksa Console Output untuk detail.'
        }
    }
}
