// ============================================================================
// Jenkinsfile CI/CD untuk Moodify Frontend (Menggunakan Bun)
// Penjelasan Tahapan Pipeline:
// 1. Checkout: Mengambil kode sumber terbaru dari repositori Git.
// 2. Setup Bun: Memastikan runtime & package manager Bun tersedia di agent Jenkins
//    (menginstal otomatis jika belum ada di mesin agent).
// 3. Install Dependencies: Menjalankan `bun install --frozen-lockfile` di folder
//    frontend/ agar versi paket konsisten sesuai bun.lock.
// 4. Build Production: Menjalankan `bun run build` untuk menghasilkan aset statis
//    siap pakai di dalam folder frontend/dist/.
// 5. Archive Artifacts: Mengarsipkan seluruh isi folder dist/ sebagai artefak build.
// ============================================================================

pipeline {
    agent any

    environment {
        VITE_API_URL = "${env.VITE_API_URL ?: 'http://localhost:5000'}"
        BUN_INSTALL = "${env.WORKSPACE}/.bun"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Bun') {
            steps {
                script {
                    if (isUnix()) {
                        sh '''
                            if ! command -v bun >/dev/null 2>&1; then
                                echo "Menginstal Bun di agent Linux/macOS..."
                                curl -fsSL https://bun.sh/install | bash -s "bun-v1.2.4"
                            fi
                            export PATH="$BUN_INSTALL/bin:$HOME/.bun/bin:$PATH"
                            bun --version
                        '''
                    } else {
                        bat '''
                            where bun >nul 2>nul
                            if %ERRORLEVEL% neq 0 (
                                echo Menginstal Bun di agent Windows...
                                powershell -Command "irm bun.sh/install.ps1 | iex"
                            )
                            bun --version
                        '''
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh '''
                                export PATH="$BUN_INSTALL/bin:$HOME/.bun/bin:$PATH"
                                bun install --frozen-lockfile
                            '''
                        } else {
                            bat 'bun install --frozen-lockfile'
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    script {
                        if (isUnix()) {
                            sh '''
                                export PATH="$BUN_INSTALL/bin:$HOME/.bun/bin:$PATH"
                                bun run build
                            '''
                        } else {
                            bat 'bun run build'
                        }
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir('frontend') {
                    // Arsipkan seluruh hasil build produksi di folder dist/
                    archiveArtifacts artifacts: 'dist/**/*', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline Moodify Frontend selesai dijalankan.'
        }
        success {
            echo 'Build Moodify Frontend berhasil dan folder dist/ telah diarsipkan!'
        }
        failure {
            echo 'Pipeline gagal. Silakan periksa log pada Console Output.'
        }
    }
}
