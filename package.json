{
  "name": "moodify-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo aplikasi Moodify (Backend REST API + Frontend React Vite)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "bun run --cwd backend start",
    "dev": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "preview": "bun run --cwd frontend preview",
    "test": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.7",
    "vitest": "^3.0.7"
  }
}
